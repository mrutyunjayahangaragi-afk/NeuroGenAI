# Neuro Gen AI 2.0 — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ──────────────────────────────────────────────
# OPTIONAL 1: OpenRouter API (Multi-Model Cloud LLM Gateway)
# ──────────────────────────────────────────────
# Get API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ──────────────────────────────────────────────
# OPTIONAL 2: Gemini API
# ──────────────────────────────────────────────
# Get API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GENAI_MODEL=gemini-2.0-flash

# ──────────────────────────────────────────────
# OPTIONAL 3: Ollama (Local, free, no API key)
# ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ──────────────────────────────────────────────
# OPTIONAL 4: Cloudinary CDN (Public Media Optimization)
# ──────────────────────────────────────────────
CLOUDINARY_URL=
CLOUDINARY_HERO_IMAGE_URL=

# ──────────────────────────────────────────────
# OPTIONAL 5: Production Network Configuration
# ──────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:8000/api
CORS_ORIGINS=*
PORT=8000